# Copy to .env and fill in. Never commit .env.

# --- Server (never exposed to the browser) ---
PORT=8787
# NVIDIA API key from build.nvidia.com (used for ASR, LLM and TTS). Placeholder value:
NVIDIA_API_KEY=
# Optional overrides (defaults shown in server/config.ts):
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# ASR_LANGUAGE=es-US
# TTS_LANGUAGE=es-US
# TTS_VOICE=Magpie-Multilingual.ES-US.Isabela
# TTS_SAMPLE_RATE=22050
# TURN_RATE_LIMIT=30
# AVATAR_INSTRUCTIONS=...

# --- Client (VITE_* variables ARE bundled into the browser; never put secrets here) ---
# Rigged GLB with ARKit blendshapes. `npm run setup:avatar` downloads a demo head to /models/facecap.glb.
VITE_AVATAR_URL=
